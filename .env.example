# Copy to .env (Prisma CLI) and .env.local (Next.js) — or keep one .env.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://substream:substream@localhost:5432/substream
# openssl rand -base64 32
AUTH_SECRET=
# SMTP for magic links, e.g. smtp://user:pass@smtp.example.com:587 (unset in dev ⇒ link is logged)
EMAIL_SERVER=
EMAIL_FROM="substream.movie <no-reply@substream.movie>"
# Optional Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Needed behind proxies / with `next start` locally (or set AUTH_URL)
AUTH_TRUST_HOST=true
# Local/e2e only: log magic links when EMAIL_SERVER is unset, even with `next start`
AUTH_LOG_MAGIC_LINKS=false
# Optional LibreTranslate-compatible endpoint for word lookup (built-in glossary is used otherwise)
TRANSLATE_API_URL=
TRANSLATE_API_KEY=
